{
  "name": "neon-flux-game",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:game\"",
    "dev:game": "webpack serve --mode development --host 0.0.0.0 --port 8080",
    "dev:server": "nodemon --exec ts-node src/index.ts",
    "build:game": "webpack --mode production",
    "build:server": "tsc --project tsconfig.server.json",
    "start:server": "node dist-server/index.js",
    "predeploy": "npm run build:game",
    "deploy:pages": "gh-pages -d dist"
  },
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "pg": "^8.11.3",
    "razorpay": "^2.9.2",
    "zod": "^3.22.4",
    "jsonwebtoken": "^9.0.2",
    "cookie-parser": "^1.4.6",
    "phaser": "^3.70.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^20.14.12",
    "@types/pg": "^8.10.9",
    "@types/cookie-parser": "^1.4.6",
    "concurrently": "^9.0.1",
    "gh-pages": "^6.0.1",
    "html-webpack-plugin": "^5.3.1",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3",
    "webpack": "^5.89.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^4.15.1",
    "nodemon": "^3.0.2"
  }
}